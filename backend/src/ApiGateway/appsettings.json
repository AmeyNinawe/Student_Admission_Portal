{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning",
      "Yarp": "Warning"
    }
  },
  "AllowedHosts": "*",
  "Cors": {
    "AllowedOrigins": [ "http://localhost:3000", "http://localhost:5173" ]
  },
  "ReverseProxy": {
    "Routes": {
      "auth-route": {
        "ClusterId": "auth-cluster",
        "Match": { "Path": "/api/auth/{**catch-all}" }
      },
      "students-route": {
        "ClusterId": "student-cluster",
        "Match": { "Path": "/api/students/{**catch-all}" }
      },
      "admin-route": {
        "ClusterId": "student-cluster",
        "Match": { "Path": "/api/admin/{**catch-all}" }
      }
    },
    "Clusters": {
      "auth-cluster": {
        "Destinations": {
          "auth-service": { "Address": "http://localhost:5001/" }
        }
      },
      "student-cluster": {
        "Destinations": {
          "student-service": { "Address": "http://localhost:5002/" }
        }
      }
    }
  }
}
